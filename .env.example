# Copy to .env for local overrides. No secrets are required.
APP_ENV=development          # development enables CORS for the Vite dev server
LOG_LEVEL=INFO
MAX_UPLOAD_MB=5              # upload size limit
UPLOAD_TTL_SECONDS=7200      # how long uploaded datasets stay in memory
MAX_UPLOADS=20               # uploaded datasets kept at once
# CORS_ORIGINS=https://example.com   # only needed if the frontend is hosted on another origin
# PORT=5000

# frontend/.env (only for a split deployment where the API is on another origin)
# VITE_API_BASE_URL=https://your-api.onrender.com
